<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题：中性偏冷的底色 + 单一强调色，避免旧版蓝灰色带来的“系统工具”感。 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="CardBorderStrongBrush" Color="#D3DAE4" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EDF1F6" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1F26" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5C6779" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#8A94A4" />

    <SolidColorBrush x:Key="AccentBrush" Color="#3F7FE8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3373D6" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2C64BD" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF2FF" />
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#DCEAFF" />
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#1F9D63" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E6F7EF" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B87813" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF5E2" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C9453F" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />

    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#F1F4F9" />
    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#E4EEFF" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#DCE3ED" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9D2DE" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#AEBACB" />

    <!-- 自绘控件（热力图、时段图、日历、图表）从这里取色，保证与 XAML 部分同源。 -->
    <SolidColorBrush x:Key="HeatCellBorderBrush" Color="#DDE4EE" />
    <SolidColorBrush x:Key="HeatEmptyBrush" Color="#F4F6FA" />
    <SolidColorBrush x:Key="ActivityInactiveBrush" Color="#E6EBF3" />
    <SolidColorBrush x:Key="ActivityActiveBrush" Color="#7FAEFF" />
    <SolidColorBrush x:Key="ActivityFireBrush" Color="#F2A03D" />

    <Color x:Key="HeatEmptyColor">#F4F6FA</Color>
    <Color x:Key="HeatCellBorderColor">#DDE4EE</Color>
    <Color x:Key="HeatPressedBorderColor">#2F6FD0</Color>
    <Color x:Key="HeatEmptyLabelColor">#6B7688</Color>
    <Color x:Key="HeatWeakTextColor">#33404F</Color>
    <Color x:Key="HeatStrongTextColor">#FFFFFF</Color>
    <Color x:Key="TimelineLabelColor">#8A94A4</Color>
    <Color x:Key="ActivityInactiveColor">#E6EBF3</Color>
    <Color x:Key="ActivityActiveColor">#7FAEFF</Color>
    <Color x:Key="ActivityFireColor">#F2A03D</Color>
    <Color x:Key="ShadowColor">#7C8CA5</Color>

</ResourceDictionary>
