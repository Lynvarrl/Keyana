<Window x:Class="Keyana.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Keyana.App.Controls"
        Title="Keyana · 键盘与鼠标使用统计"
        Icon="Assets/Keyana.ico"
        Width="1280" Height="820" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 侧边栏 ================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!-- 仅 Development 构建使用的构建标识行；Release 下 Collapsed，不占高度。 -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="K" Foreground="{DynamicResource OnAccentTextBrush}"
                                   FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Keyana" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="键盘与鼠标统计" Style="{StaticResource CaptionText}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,26,0,0">
                    <RadioButton x:Name="NavOverview" Content="概览" Tag="Overview"
                                 GroupName="Navigation" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAnalysis" Content="分析" Tag="Analysis"
                                 GroupName="Navigation" Style="{StaticResource NavButtonStyle}"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Content="设置" Tag="Settings"
                                 GroupName="Navigation" Style="{StaticResource NavButtonStyle}"
                                 Checked="Nav_Checked" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,14">
                    <Border x:Name="StatusBadge" Background="Transparent"
                            CornerRadius="999" Padding="11,7" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,7,0"
                                     Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="正在采集"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" />
                            <!-- 权限只读展示：采集能力和当前进程的令牌直接相关，
                                 用户需要一眼看出「现在这个实例能不能采到管理员程序里的输入」。 -->
                            <TextBlock x:Name="ElevationText" Text="· 普通权限"
                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="所有数据仅保存在本机"
                               Style="{StaticResource CaptionText}" Margin="2,9,0,0" />
                    <TextBlock Text="不记录输入内容与顺序"
                               Style="{StaticResource CaptionText}" Margin="2,2,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="4" x:Name="VersionText" Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource TertiaryTextBrush}" Margin="2,0,0,0" />

                <!-- 调试用：只有 Development 构建显示这行 Build ID，用来确认眼前这个进程
                     是不是刚编出来的那个；Release 构建下 Collapsed，侧边栏与之前完全一致。 -->
                <TextBlock Grid.Row="5" x:Name="BuildStampText" Visibility="Collapsed"
                           Style="{StaticResource MonoText}"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Margin="2,3,0,0" />
            </Grid>
        </Border>

        <!-- ================= 内容区 ================= -->
        <ScrollViewer Grid.Column="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"
                      Background="Transparent">
            <Grid x:Name="PageHost" Margin="26,22,22,26">

                <!-- ============ 概览 ============ -->
                <Grid x:Name="OverviewPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="概览" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="键盘与鼠标输入的全景视图" Style="{StaticResource BodySecondaryText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PauseButton" Content="暂停采集"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="16,8"
                                    Focusable="False" Click="PauseButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 范围 -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="统计范围" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" Margin="0,0,12,4" />
                                <RadioButton x:Name="PresetChipToday" Content="今日" Tag="Today" GroupName="RangePreset"
                                             Style="{StaticResource ChipStyle}" IsChecked="True" Checked="PresetChip_Checked" />
                                <RadioButton x:Name="PresetChipYesterday" Content="昨日" Tag="Yesterday" GroupName="RangePreset"
                                             Style="{StaticResource ChipStyle}" Checked="PresetChip_Checked" />
                                <RadioButton x:Name="PresetChipRecent10" Content="最近 10 分钟" Tag="Recent10" GroupName="RangePreset"
                                             Style="{StaticResource ChipStyle}" Checked="PresetChip_Checked" />
                                <RadioButton x:Name="PresetChipRecent7Days" Content="近 7 日" Tag="Recent7Days" GroupName="RangePreset"
                                             Style="{StaticResource ChipStyle}" Checked="PresetChip_Checked" />
                                <RadioButton x:Name="PresetChipRecent30Days" Content="近 30 日" Tag="Recent30Days" GroupName="RangePreset"
                                             Style="{StaticResource ChipStyle}" Checked="PresetChip_Checked" />
                                <RadioButton x:Name="PresetChipAll" Content="全部" Tag="All" GroupName="RangePreset"
                                             Style="{StaticResource ChipStyle}" Checked="PresetChip_Checked" />
                                <RadioButton x:Name="PresetChipCustom" Content="自定义" Tag="Custom" GroupName="RangePreset"
                                             Style="{StaticResource ChipStyle}" Checked="PresetChip_Checked"
                                             Click="CustomChip_Click" />
                                <Button x:Name="OverviewFilterButton" Content="按键筛选" Tag=""
                                        Style="{StaticResource FilterChipButtonStyle}"
                                        Focusable="False" Click="OverviewFilterButton_Click" />
                                <Popup x:Name="OverviewFilterPopup"
                                       PlacementTarget="{Binding ElementName=OverviewFilterButton}"
                                       Placement="Bottom" VerticalOffset="6" StaysOpen="False"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <controls:KeyFilterPanel x:Name="OverviewFilterPanel" />
                                </Popup>
                            </WrapPanel>

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:DateRangePicker x:Name="OverviewRangePicker"
                                                          RangeApplied="OverviewRangePicker_RangeApplied" />
                                <TextBlock x:Name="RangeValidationText" Grid.Column="1"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="结束时间不含"
                                           Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 指标 -->
                    <UniformGrid Grid.Row="2" Columns="5" Margin="0,14,-10,0">
                        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock x:Name="RangeTotalLabel" Text="所选范围总输入" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="RangeTotalText" Text="0" Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                                <TextBlock x:Name="RangeTotalHintText" Text="—" Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="活跃天数" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="ActiveDaysText" Text="0" Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                                <TextBlock x:Name="ActiveDaysHintText" Text="每天 ≥325 次" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="UsageDurationCard" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,10,0"
                                Cursor="Hand" ToolTip="双击切换显示单位：天 / 小时"
                                MouseLeftButtonDown="UsageDurationCard_MouseLeftButtonDown">
                            <StackPanel>
                                <TextBlock Text="使用时长" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="UsageDurationText" Text="0 分" Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                                <TextBlock x:Name="UsageDurationHintText" Text="已选0h · 0%"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="火热日" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="FireDaysText" Text="0" Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                                <TextBlock x:Name="FireDaysHintText" Text="每天 ≥7999 次" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="本次运行" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="RunTotalText" Text="0" Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                                <TextBlock x:Name="TotalHistoryText" Text="总数量：正在加载…" Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 热力图 -->
                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="键盘与鼠标热力图" Style="{StaticResource CardTitleText}" />
                                    <TextBlock x:Name="HeatmapRangeText" Text="正在加载范围…"
                                               Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                    <!-- 配列说明：换了紧凑配列后，没画出来的键会在这里明确写出来，
                                         免得用户以为数据丢了。 -->
                                    <TextBlock x:Name="LayoutHintText" Style="{StaticResource CaptionText}"
                                               Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="配色" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="PaletteChipBlue" Content="蓝品红" Tag="BlueMagenta"
                                                         GroupName="Palette" Style="{StaticResource ChipStyle}"
                                                         IsChecked="True" Checked="PaletteChip_Checked" />
                                            <RadioButton x:Name="PaletteChipGreen" Content="绿琥珀" Tag="GreenAmber"
                                                         GroupName="Palette" Style="{StaticResource ChipStyle}"
                                                         Checked="PaletteChip_Checked" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="色阶" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ScaleChipSquareRoot" Content="平方根" Tag="SquareRoot"
                                                         GroupName="Scale" Style="{StaticResource ChipStyle}"
                                                         IsChecked="True" Checked="ScaleChip_Checked" />
                                            <RadioButton x:Name="ScaleChipLinear" Content="线性" Tag="Linear"
                                                         GroupName="Scale" Style="{StaticResource ChipStyle}"
                                                         Checked="ScaleChip_Checked" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <controls:KeyboardHeatmapControl x:Name="HeatmapKeyboard" Grid.Row="1"
                                                             Height="300" Margin="0,14,0,0" />

                            <Grid Grid.Row="2" Margin="2,10,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="0" Style="{StaticResource CaptionText}" Margin="0,0,6,0" />
                                    <Border Width="16" Height="11" CornerRadius="3" Margin="0,0,6,0"
                                            Background="{DynamicResource HeatEmptyBrush}"
                                            BorderBrush="{DynamicResource HeatCellBorderBrush}" BorderThickness="1" />
                                    <TextBlock Text="低" Style="{StaticResource CaptionText}" Margin="0,0,5,0" />
                                    <Border x:Name="GradientBar" Width="160" Height="11" CornerRadius="3"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#F7F8FA" Offset="0" />
                                                <GradientStop Color="#4B8CD7" Offset="0.6" />
                                                <GradientStop Color="#D74B8C" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="高" Style="{StaticResource CaptionText}" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="HeatmapTotalText" Grid.Column="1" HorizontalAlignment="Center"
                                           Text="所选范围总计：0" FontWeight="SemiBold"
                                           FontSize="{DynamicResource FontSizeSmall}" />
                                <TextBlock x:Name="HeatmapUpdatedText" Grid.Column="2"
                                           Style="{StaticResource CaptionText}" Text="尚未更新" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 时段 -->
                    <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="时段分布" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="所选范围按每天相同的 10 分钟时段汇总"
                                               Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="DailyTimelineSummaryText" Grid.Column="1"
                                           Text="暂无输入" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <controls:TenMinuteTimelineControl x:Name="DailyTimeline" Margin="2,16,2,0" />
                        </StackPanel>
                    </Border>

                    <!-- 鼠标 + 每日活跃 -->
                    <Grid Grid.Row="5" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.55*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="鼠标与滚轮" Style="{StaticResource CardTitleText}" />
                                <!-- 逐键明细已经并进上方热力图的「鼠标」一行，这里只留总量与占比：
                                     同一份数据不在两张卡片上各画一遍。 -->
                                <TextBlock Text="逐键次数见上方热力图底部的「鼠标」一行"
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />

                                <TextBlock Text="鼠标输入" Style="{StaticResource CaptionText}" Margin="0,18,0,0" />
                                <TextBlock x:Name="MouseTotalText" Text="0" Style="{StaticResource MetricValueText}"
                                           Margin="0,4,0,0" />

                                <TextBlock Text="占全部输入" Style="{StaticResource CaptionText}" Margin="0,14,0,0" />
                                <TextBlock x:Name="MouseShareText" Text="0%" FontSize="{DynamicResource FontSizeTitle}"
                                           FontWeight="SemiBold" Margin="0,3,0,0" />

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16" />

                                <!-- 滚轮的两个独立指标：距离是「让屏幕走了多远」，手势是「做了几次
                                     上滑 / 下滑动作」。两者可逆性不同（距离能从原始值重算，手势不行），
                                     所以并排放，不要合成一个数字。 -->
                                <TextBlock Text="滚轮距离" Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="WheelDistanceText" Text="0 格" FontWeight="SemiBold"
                                           FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,3,0,0" />
                                <TextBlock x:Name="WheelDistanceEstimateText" Text="≈ 0 cm · 估算"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap" />

                                <TextBlock Text="滑动手势" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                                <TextBlock x:Name="WheelGestureText" Text="上滑 0 · 下滑 0" FontWeight="SemiBold"
                                           FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="每日活跃" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="每根柱 = 一天 · 淡蓝底 = 主统计范围"
                                                   Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <controls:DateRangePicker x:Name="ActivityRangePicker" Grid.Column="1"
                                                              VerticalAlignment="Center"
                                                              RangeApplied="ActivityRangePicker_RangeApplied" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="ActivityPresetChipRecent30Days" Content="近 30 日" Tag="Recent30Days"
                                                     GroupName="ActivityRangePreset" Style="{StaticResource ChipStyle}"
                                                     Padding="10,4" Margin="0,0,6,0" IsChecked="True"
                                                     Checked="ActivityPresetChip_Checked" />
                                        <RadioButton x:Name="ActivityPresetChipRecent90Days" Content="近 90 日" Tag="Recent90Days"
                                                     GroupName="ActivityRangePreset" Style="{StaticResource ChipStyle}"
                                                     Padding="10,4" Margin="0,0,6,0"
                                                     Checked="ActivityPresetChip_Checked" />
                                        <RadioButton x:Name="ActivityPresetChipAll" Content="全部" Tag="All"
                                                     GroupName="ActivityRangePreset" Style="{StaticResource ChipStyle}"
                                                     Padding="10,4" Margin="0,0,6,0"
                                                     Checked="ActivityPresetChip_Checked" />
                                    </StackPanel>
                                    <TextBlock x:Name="ActivitySummaryText" Grid.Column="1" Text="近 30 日"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <controls:DailyActivityControl x:Name="ActivityStrip" Grid.Row="2" Margin="2,14,2,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 实时 -->
                    <Border Grid.Row="6" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="当前按下" Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="PressedKeysText" Text="无" FontWeight="SemiBold" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="最近输入" Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="LastInputText" Text="等待输入…" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                <TextBlock Text="未识别输入" Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="UnknownInputText" Text="未识别输入：0" Margin="0,3,0,0"
                                           Foreground="{DynamicResource WarningBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ 分析 ============ -->
                <Grid x:Name="AnalysisPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="分析" Style="{StaticResource PageTitleText}" />
                            <TextBlock x:Name="AnalysisRangeHintText" Text="独立统计区间，不影响概览页"
                                       Style="{StaticResource BodySecondaryText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="AnalysisPresetAll" Content="全部" Tag="All"
                                         GroupName="AnalysisRangePreset" Style="{StaticResource ChipStyle}"
                                         Checked="AnalysisPresetChip_Checked" />
                            <RadioButton x:Name="AnalysisPresetRecent30Days" Content="近 30 日" Tag="Recent30Days"
                                         GroupName="AnalysisRangePreset" Style="{StaticResource ChipStyle}"
                                         IsChecked="True" Checked="AnalysisPresetChip_Checked" />
                            <RadioButton x:Name="AnalysisPresetRecent7Days" Content="近 7 日" Tag="Recent7Days"
                                         GroupName="AnalysisRangePreset" Style="{StaticResource ChipStyle}"
                                         Checked="AnalysisPresetChip_Checked" />
                            <RadioButton x:Name="AnalysisPresetYesterday" Content="昨日" Tag="Yesterday"
                                         GroupName="AnalysisRangePreset" Style="{StaticResource ChipStyle}"
                                         Checked="AnalysisPresetChip_Checked" />
                            <RadioButton x:Name="AnalysisPresetToday" Content="今日" Tag="Today"
                                         GroupName="AnalysisRangePreset" Style="{StaticResource ChipStyle}"
                                         Checked="AnalysisPresetChip_Checked" />
                            <controls:DateRangePicker x:Name="AnalysisRangePicker"
                                                      Margin="8,0,0,0"
                                                      RangeApplied="AnalysisRangePicker_RangeApplied" />
                            <Button x:Name="AnalysisFilterButton" Content="按键筛选" Tag=""
                                    Style="{StaticResource FilterChipButtonStyle}" Margin="8,0,0,0"
                                    Focusable="False" Click="AnalysisFilterButton_Click" />
                            <Popup x:Name="AnalysisFilterPopup"
                                   PlacementTarget="{Binding ElementName=AnalysisFilterButton}"
                                   Placement="Bottom" VerticalOffset="6" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <controls:KeyFilterPanel x:Name="AnalysisFilterPanel" />
                            </Popup>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,-10,0">
                        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="区间总输入" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="AnalysisTotalText" Text="0" Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                                <TextBlock x:Name="AnalysisTotalHintText" Text="含键盘、鼠标按键与滚轮手势" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="日均输入" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="AnalysisAverageText" Text="0" Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                                <TextBlock Text="按自然日跨度计算" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="活跃天数" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="AnalysisActiveDaysText" Text="0" Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                                <TextBlock Text="每天 ≥325 次" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="AnalysisDurationCard" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,10,0"
                                Cursor="Hand" ToolTip="双击切换显示单位：天 / 小时"
                                MouseLeftButtonDown="UsageDurationCard_MouseLeftButtonDown">
                            <StackPanel>
                                <TextBlock Text="使用时长" Style="{StaticResource MetricLabelText}" />
                                <TextBlock x:Name="AnalysisDurationText" Text="0 分" Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                                <TextBlock x:Name="AnalysisDurationHintText" Text="已选0h · 0%"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,14,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="按键排行榜" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="按所选区间内的按下次数排序" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,14,0,0" MinHeight="300">
                                    <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="RankingList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="54" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Rank}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                                                   VerticalAlignment="Top" Margin="0,1,0,0" />
                                                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <ProgressBar Value="{Binding Share}" Margin="0,5,0,0"
                                                                         ToolTip="{Binding Category}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding CountText}"
                                                                   HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="3" Text="{Binding ShareText}"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="RankingEmptyText" Text="所选区间暂无输入"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Style="{StaticResource BodySecondaryText}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource CardStyle}" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="类别占比" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="按键、鼠标与滚轮手势的输入构成" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                    <controls:CategoryShareControl x:Name="CategoryShare" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 滚轮拆成两个指标后单独给一张卡：距离不是次数，混进排行榜与占比
                                 会把「一滑几百格」重新带回来。 -->
                            <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="滚轮：距离与手势" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="距离是累计滚动量（一格 = 120），手势是一次上滑 / 下滑动作"
                                               Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="滚动距离" Style="{StaticResource CaptionText}" />
                                            <TextBlock x:Name="AnalysisWheelDistanceText" Text="0 格"
                                                       FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock x:Name="AnalysisWheelEstimateText" Text="≈ 0 cm · 估算"
                                                       Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="滑动手势" Style="{StaticResource CaptionText}" />
                                            <TextBlock x:Name="AnalysisWheelGestureText" Text="上滑 0 · 下滑 0"
                                                       FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="上 / 下分别计次" Style="{StaticResource CaptionText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="每日输入" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="悬停查看当天详情" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                    <controls:DailyActivityControl x:Name="AnalysisDailyStrip" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="全部键位" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="所选区间内每个键与按钮的累计次数" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ActiveOnlyCheckBox" Grid.Column="1" Content="只显示有次数或按下中的键"
                                          VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="300" Margin="0,12,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="KeyChipList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InnerTileStyle}" Padding="10,7" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Count, StringFormat={}{0:N0}}"
                                                               FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <Ellipse Width="6" Height="6" Margin="7,1,0,0"
                                                             Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                                             Visibility="{Binding IsPressed, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ 设置 ============ -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="外观与数据都只影响本机" Style="{StaticResource BodySecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="外观" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="主题与字体调整后立即生效" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />

                                <TextBlock Text="主题" Style="{StaticResource SectionTitleText}" Margin="0,18,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="ThemeChipSystem" Content="跟随系统" Tag="System"
                                                 GroupName="Theme" Style="{StaticResource ChipStyle}"
                                                 IsChecked="True" Checked="ThemeChip_Checked" />
                                    <RadioButton x:Name="ThemeChipLight" Content="浅色" Tag="Light"
                                                 GroupName="Theme" Style="{StaticResource ChipStyle}"
                                                 Checked="ThemeChip_Checked" />
                                    <RadioButton x:Name="ThemeChipDark" Content="深色" Tag="Dark"
                                                 GroupName="Theme" Style="{StaticResource ChipStyle}"
                                                 Checked="ThemeChip_Checked" />
                                </WrapPanel>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18" />

                                <TextBlock Text="界面字体" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="列表来自系统已安装字体；字号会同时缩放正文、标题与指标" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,8" TextWrapping="Wrap" />
                                <ComboBox x:Name="FontFamilyComboBox" Width="240" HorizontalAlignment="Left"
                                          SelectionChanged="FontFamilyComboBox_SelectionChanged" />

                                <TextBlock Text="字号" Style="{StaticResource SectionTitleText}" Margin="0,16,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="FontScaleChipCompact" Content="紧凑" Tag="0.9"
                                                 GroupName="FontScale" Style="{StaticResource ChipStyle}"
                                                 Checked="FontScaleChip_Checked" />
                                    <RadioButton x:Name="FontScaleChipStandard" Content="标准" Tag="1.0"
                                                 GroupName="FontScale" Style="{StaticResource ChipStyle}"
                                                 IsChecked="True" Checked="FontScaleChip_Checked" />
                                    <RadioButton x:Name="FontScaleChipLarge" Content="大" Tag="1.1"
                                                 GroupName="FontScale" Style="{StaticResource ChipStyle}"
                                                 Checked="FontScaleChip_Checked" />
                                    <RadioButton x:Name="FontScaleChipXLarge" Content="特大" Tag="1.25"
                                                 GroupName="FontScale" Style="{StaticResource ChipStyle}"
                                                 Checked="FontScaleChip_Checked" />
                                </WrapPanel>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18" />

                                <!-- 着色基准：键盘与鼠标分开选。鼠标左键的次数往往是任何单个键的数倍，
                                     默认各比各的；想横向比较两边量级时可以改成「键盘 + 鼠标」。 -->
                                <TextBlock Text="热力图着色基准" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="决定「最亮的键」从哪一组里挑。键盘选「键盘 + 鼠标」时，通常会被鼠标左键压得整体变浅。"
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,10" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="键盘" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <ComboBox x:Name="KeyboardBasisComboBox" Grid.Column="1" Width="170"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="ColorBasisComboBox_SelectionChanged" />
                                    <TextBlock Grid.Row="1" Text="鼠标" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="0,8,10,0" />
                                    <ComboBox x:Name="MouseBasisComboBox" Grid.Row="1" Grid.Column="1" Width="170"
                                              HorizontalAlignment="Left" Margin="0,8,0,0"
                                              SelectionChanged="ColorBasisComboBox_SelectionChanged" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18" />

                                <!-- 配列只改画法：采集、入库与排行榜都按物理键走，
                                     换一套配列不会改变任何一个数字。 -->
                                <TextBlock Text="键盘配列" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="只影响热力图的画法，不改变任何统计口径；没画出来的键仍会出现在排行榜里。"
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,8" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="LayoutComboBox" HorizontalAlignment="Left" Width="240"
                                              SelectionChanged="LayoutComboBox_SelectionChanged" />
                                    <Button x:Name="ImportLayoutButton" Grid.Column="1" Content="导入布局…"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"
                                            Margin="8,0,0,0" Focusable="False" Click="ImportLayoutButton_Click" />
                                </Grid>
                                <TextBlock x:Name="LayoutPathText" Style="{StaticResource MonoText}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="采集与数据" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="采集是后台常驻的，关闭窗口不会停止" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0" TextWrapping="Wrap" />

                                <CheckBox x:Name="StartupCheckBox" Content="登录 Windows 后自动启动"
                                          Margin="0,18,0,0" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />
                                <CheckBox x:Name="StartupAdminCheckBox" Content="以管理员权限自启"
                                          Margin="24,8,0,0" IsEnabled="False"
                                          Checked="StartupAdminCheckBox_Changed" Unchecked="StartupAdminCheckBox_Changed" />
                                <CheckBox x:Name="SnapCheckBox" Content="自定义范围向外吸附到 10 分钟边界"
                                          Margin="0,12,0,0" Checked="SnapCheckBox_Changed" Unchecked="SnapCheckBox_Changed" />

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18" />

                                <TextBlock Text="数据文件" Style="{StaticResource SectionTitleText}" />
                                <TextBlock x:Name="DataPathText" Text="Data\keyana.db" Style="{StaticResource MonoText}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="DataSizeText" Text="大小：正在加载…" Style="{StaticResource CaptionText}"
                                           Margin="0,4,0,0" />
                                <TextBlock x:Name="StorageStatusText" Text="本地数据：正在初始化…"
                                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="SaveNowButton" Content="立即保存"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                                            IsEnabled="False" Click="SaveNowButton_Click" />
                                    <Button x:Name="RetryStorageButton" Content="重试初始化"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                                            Visibility="Collapsed" Margin="8,0,0,0"
                                            Click="RetryStorageButton_Click" />
                                    <Button x:Name="ExportButton" Content="导出 CSV"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                                            IsEnabled="False" Margin="8,0,0,0" Click="ExportButton_Click" />
                                    <Button Content="清零本次显示"
                                            Style="{StaticResource GhostButtonStyle}" Padding="12,7"
                                            Margin="8,0,0,0" Click="ClearButton_Click" />
                                </WrapPanel>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18" />

                                <!-- 进程级操作放在卡片最底部：日常使用不需要碰，
                                     放在这里既找得到，又不会被顺手点到。 -->
                                <TextBlock Text="应用" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="重启会先保存当前这一分钟的数据；完整退出会停止采集并退出程序"
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="RestartButton" Content="重启 Keyana"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                                            Focusable="False" Click="RestartButton_Click" />
                                    <Button x:Name="ExitButton" Content="完整退出"
                                            Style="{StaticResource DangerButtonStyle}" Padding="14,7"
                                            Margin="8,0,0,0" Focusable="False" Click="ExitButton_Click" />
                                </StackPanel>

                                <Popup x:Name="RestartPopup" PlacementTarget="{Binding ElementName=RestartButton}"
                                       Placement="Top" VerticalOffset="-8" StaysOpen="False"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderStrongBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="8" MinWidth="248">
                                        <StackPanel>
                                            <TextBlock x:Name="RestartPopupHint" Style="{StaticResource CaptionText}"
                                                       Margin="8,6,8,8" TextWrapping="Wrap" />
                                            <Border Height="1" Background="{DynamicResource DividerBrush}"
                                                    Margin="0,0,0,6" />
                                            <Button x:Name="RestartNormalButton" Content="普通权限重启"
                                                    Style="{StaticResource PopupActionButtonStyle}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Click="RestartNormalButton_Click" />
                                            <Button x:Name="RestartElevatedButton" Content="管理员权限重启"
                                                    Style="{StaticResource PopupActionButtonStyle}"
                                                    Margin="0,2,0,0" Click="RestartElevatedButton_Click" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 滚轮：距离与手势是两套指标，手势窗口更适合按自己的设备现场调。 -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="滚轮采集与校准" Style="{StaticResource CardTitleText}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                       Text="两个指标同时记：滚动距离忠实保存原始 delta，滑动手势按静默窗口计数。窗口合不合手只能自己试——滚一下，看右侧判定成了几次动作。" />
                            <controls:WheelCalibrationPanel x:Name="WheelPanel" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0"
                            x:Name="AboutCard">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="隐私与数据格式" Style="{StaticResource CardTitleText}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource BodySecondaryText}" Margin="0,6,0,0"
                                           Text="数据库只保存每一分钟内各按键或按钮的累计次数、滚轮滚动距离与滑动手势次数，不记录输入内容、输入顺序、正在使用的应用或鼠标位置；无需账号，不连接服务器。" />
                            </StackPanel>

                            <!-- 构建信息：不新开页面或弹窗，作为「关于」区域的辅助信息贴在卡片右下角，
                                 视觉层级低于上面的隐私说明与版本行。数值全部来自构建时写入的程序集。 -->
                            <StackPanel Grid.Column="1" Margin="28,0,0,0"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <TextBlock x:Name="AboutVersionText" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" />

                                <Border Style="{StaticResource InnerTileStyle}" Padding="12,10"
                                        Margin="0,10,0,0" HorizontalAlignment="Right"
                                        x:Name="BuildInfoCard">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="构建信息" Style="{StaticResource BuildInfoLabelText}"
                                                       VerticalAlignment="Center" />
                                            <Button x:Name="CopyBuildInfoButton" Grid.Column="1" Content="复制"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    Padding="8,2" Margin="12,0,0,0" Focusable="False"
                                                    Click="CopyBuildInfoButton_Click" />
                                        </Grid>

                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Version" Style="{StaticResource BuildInfoLabelText}"
                                                       Margin="0,0,16,3" />
                                            <TextBlock x:Name="BuildVersionValue" Grid.Column="1"
                                                       Style="{StaticResource BuildInfoValueText}"
                                                       HorizontalAlignment="Right" Margin="0,0,0,3" />

                                            <TextBlock Grid.Row="1" Text="Build ID" Style="{StaticResource BuildInfoLabelText}"
                                                       Margin="0,0,16,3" />
                                            <TextBlock x:Name="BuildIdValue" Grid.Row="1" Grid.Column="1"
                                                       Style="{StaticResource BuildInfoValueText}"
                                                       HorizontalAlignment="Right" Margin="0,0,0,3" />

                                            <TextBlock Grid.Row="2" Text="Git Commit" Style="{StaticResource BuildInfoLabelText}"
                                                       Margin="0,0,16,3" />
                                            <TextBlock x:Name="BuildCommitValue" Grid.Row="2" Grid.Column="1"
                                                       Style="{StaticResource BuildInfoValueText}"
                                                       HorizontalAlignment="Right" Margin="0,0,0,3" />

                                            <TextBlock Grid.Row="3" Text="Git Status" Style="{StaticResource BuildInfoLabelText}"
                                                       Margin="0,0,16,3" />
                                            <TextBlock x:Name="BuildStatusValue" Grid.Row="3" Grid.Column="1"
                                                       Style="{StaticResource BuildInfoValueText}"
                                                       HorizontalAlignment="Right" Margin="0,0,0,3" />

                                            <TextBlock Grid.Row="4" Text="Build Type" Style="{StaticResource BuildInfoLabelText}"
                                                       Margin="0,0,16,0" />
                                            <TextBlock x:Name="BuildTypeValue" Grid.Row="4" Grid.Column="1"
                                                       Style="{StaticResource BuildInfoValueText}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ================= 二次确认浮层 =================
             系统 MessageBox 在深色主题下是一块白框，和界面完全脱节；
             这里用页面内浮层做 modal：盖住整个窗口（含侧边栏）、点遮罩不关闭、
             Esc 等于取消、默认焦点落在「取消」上，避免一路回车退出程序。 -->
        <Grid x:Name="ConfirmOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="#A6000000" Focusable="True" PreviewKeyDown="ConfirmOverlay_PreviewKeyDown"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border Width="420" Style="{StaticResource CardStyle}" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitleText" Text="完整退出 Keyana"
                               Style="{StaticResource CardTitleText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConfirmMessageText" Style="{StaticResource BodySecondaryText}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="ConfirmCancelButton" Content="取消"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="18,8"
                                IsCancel="True" Click="ConfirmCancelButton_Click" />
                        <Button x:Name="ConfirmAcceptButton" Content="完整退出"
                                Style="{StaticResource DangerSolidButtonStyle}" Padding="18,8"
                                Margin="8,0,0,0" Click="ConfirmAcceptButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
