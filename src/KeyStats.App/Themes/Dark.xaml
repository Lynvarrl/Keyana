<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：不是把浅色反相，而是压暗底色、抬高卡片、降低纯白文本亮度，减轻长时间阅读的眩光。 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1116" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#12161C" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#171C24" />
    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#1D232C" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#252C36" />
    <SolidColorBrush x:Key="CardBorderStrongBrush" Color="#333C48" />
    <SolidColorBrush x:Key="DividerBrush" Color="#222932" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E9EEF6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9AA6B6" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#6E7A8A" />

    <SolidColorBrush x:Key="AccentBrush" Color="#5B9CFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7BB2FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A86E0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E2C42" />
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#26374F" />
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE9B" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#163226" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B75B" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#33260F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F2777A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#34191B" />

    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#1B212A" />
    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#26364E" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#2A323D" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1A2028" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2C3542" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#1F2630" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#333C48" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4452" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4C5868" />

    <SolidColorBrush x:Key="HeatCellBorderBrush" Color="#2A323D" />
    <SolidColorBrush x:Key="HeatEmptyBrush" Color="#1C222B" />
    <SolidColorBrush x:Key="ActivityInactiveBrush" Color="#232A34" />
    <SolidColorBrush x:Key="ActivityActiveBrush" Color="#4E86D8" />
    <SolidColorBrush x:Key="ActivityFireBrush" Color="#D98A34" />

    <Color x:Key="HeatEmptyColor">#1C222B</Color>
    <Color x:Key="HeatCellBorderColor">#2A323D</Color>
    <Color x:Key="HeatPressedBorderColor">#8CB8FF</Color>
    <Color x:Key="HeatEmptyLabelColor">#8D99A9</Color>
    <Color x:Key="HeatWeakTextColor">#C9D3E1</Color>
    <Color x:Key="HeatStrongTextColor">#0B1017</Color>
    <Color x:Key="TimelineLabelColor">#6E7A8A</Color>
    <Color x:Key="ActivityInactiveColor">#232A34</Color>
    <Color x:Key="ActivityActiveColor">#4E86D8</Color>
    <Color x:Key="ActivityFireColor">#D98A34</Color>
    <Color x:Key="ShadowColor">#000000</Color>

</ResourceDictionary>
